# ===== 火山引擎 Mem0 服务环境变量模板 =====
# 复制本文件为 .env 并填入真实凭据

# 火山引擎 Mem0 服务地址 (注意：不带尾部斜杠)
# 北京节点示例：https://mem0-cn-beijing.volces.com
VOLC_MEM0_HOST=https://mem0-cn-beijing.volces.com

# 火山引擎 Mem0 API Key (在火山引擎控制台 Mem0 项目页获取)
VOLC_MEM0_API_KEY=your_volcano_mem0_api_key_here

# ===== 服务运行配置 =====
# FastAPI 服务监听地址
MEM0_SERVICE_HOST=127.0.0.1
# FastAPI 服务监听端口
MEM0_SERVICE_PORT=8765

# ===== 协调器配置 =====
# 令牌桶限流 QPS (火山引擎硬限 20 QPS，保守设为 18)
MEM0_QPS_LIMIT=18
# API 调用强制超时秒数 (防止网络黑洞卡死)
MEM0_REQUEST_TIMEOUT=5
# 读操作超时秒数 (检索类操作，更短)
MEM0_READ_TIMEOUT=3
# 防复活黑名单 TTL 秒数
MEM0_BLACKLIST_TTL=900
# 异步写入队列最大长度
MEM0_QUEUE_MAX_SIZE=1000
