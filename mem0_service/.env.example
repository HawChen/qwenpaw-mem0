# ============================================================
# 火山引擎 Mem0 记忆后端 —— 环境变量模板（v2.0）
# 用法：复制本文件为同目录 .env，填入你自己的实例地址与 API Key。
# 警告：.env 已被 .gitignore 忽略，绝不要提交真实凭据。
# ============================================================

# ---- 必填：火山引擎 Mem0 凭据（火山引擎控制台 → 火山方舟 Mem0 获取）----
# 专属实例接入地址（不带末尾斜杠），形如：
#   https://mem0-<your-instance-id>.mem0.volces.com:8000
VOLC_MEM0_HOST=https://mem0-<your-instance-id>.mem0.volces.com:8000
# API Key，形如 xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VOLC_MEM0_API_KEY=your_volcano_mem0_api_key_here

# ---- 网络与限流（一般无需修改；QPS 不得超过火山硬限 20）----
MEM0_QPS_LIMIT=18
MEM0_REQUEST_TIMEOUT=5
MEM0_READ_TIMEOUT=15

# ---- 自动记忆：检索 / 写入节奏 ----
MEM0_MEMORY_SEARCH_ENABLED=true
MEM0_MAX_RESULTS=3
MEM0_AUTO_MEMORY_INTERVAL=5
MEM0_MIN_WRITE_LENGTH=10
MEM0_KEEP_TOOL_MESSAGES=false
# 去重缓存与删除防复活黑名单的 TTL（秒），二者共用此键
MEM0_BLACKLIST_TTL=900

# ---- 用量记账与月度预算熔断（火山 Mem0 自 2026-11-02 起计费）----
MEM0_USAGE_ENABLED=true
MEM0_MONTHLY_BUDGET_YUAN=10
MEM0_CREDIT_PER_TOKEN=3.2
MEM0_YUAN_PER_MILLION_CREDIT=1.12
